# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------------------------------------------------------------------------
# SECRETS — never commit these.
#
# Every .env file is ignored, EXCEPT .env.example, which holds variable names
# only (no values) and is the reference for what needs configuring.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# Credentials and keys of any kind
*.key
*.pfx
*.p12
secrets.json
service-account*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editors
.idea/
*.swp
*.swo

# Supabase CLI scratch files
supabase/.temp/

# Generated import templates — rebuild with: npm run template
/templates/
