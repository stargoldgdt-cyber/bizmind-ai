# ============================================================================
# BizMind AI — environment variable template
# ============================================================================
#
# This file lists the NAMES of the settings BizMind needs. It contains no real
# values and is safe to commit.
#
# To configure a machine:
#   1. Copy this file to a new file named  .env.local
#   2. Fill in the real values there
#   3. Restart the dev server — these are read at startup
#
# .env.local is ignored by Git and must never be committed or shared.
#
# WARNING: any variable whose name starts with NEXT_PUBLIC_ is sent to the
# browser and is visible to anyone who visits the site. Only genuinely public
# values belong there. Everything else stays server-side.
#
# Phase 1 requires none of these. They are listed so the shape is known.
# ============================================================================


# ---- Supabase (Phase 2: authentication and database) -----------------------

# Your project URL. Public — safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=

# The anon/publishable key. Public by design; Row Level Security is what
# actually protects the data, not the secrecy of this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. The service-role key bypasses Row Level Security entirely.
# Server-side background jobs only. Never expose to the browser, never use it
# to serve a user request, never paste it into chat or a screenshot.
SUPABASE_SERVICE_ROLE_KEY=


# ---- OpenAI (Phase 8: AI business analyst) ---------------------------------

# SECRET. Server-side only, read in exactly one file
# (src/services/ai/client.ts) and never sent to the browser.
#
# OPTIONAL. Without it BizMind works exactly as before: every figure, chart and
# import is unaffected, and the dashboard simply says written explanations are
# switched off. The AI never produces a figure -- it only explains figures the
# database already calculated. See AI.md.
#
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OPTIONAL. Which model writes the explanations. Leave blank for the default.
# Model names change faster than this codebase, so run `npm run ai:check` to
# confirm whatever is set here actually exists on your account.
OPENAI_MODEL=


# ---- Integrations (Phase 9+) -----------------------------------------------

# SECRET. Shopify app credentials.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# SECRET. Used to verify that incoming webhooks genuinely came from the
# provider and were not forged.
WEBHOOK_SIGNING_SECRET=


# ---- Application -----------------------------------------------------------

# The public base URL of this deployment, e.g. http://localhost:3000 in
# development. Used to build absolute links and webhook callback URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
