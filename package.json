{
  "name": "bizmind-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run test:import && npm run test:parse && npm run test:analytics && npm run test:mapping && npm run test:ai && npm run test:money-guard && npm run test:integration-engine && npm run test:woocommerce && npm run test:google-sheets && npm run test:automation && npm run test:marketplaces && npm run test:amazon && npm run build",
    "verify:integrations": "npm run test:integration-engine && npm run test:woocommerce && npm run test:integration-live",
    "test:import": "tsx scripts/verify-import-pipeline.ts",
    "test:parse": "node --import tsx --conditions react-server scripts/verify-file-parsing.mts",
    "test:analytics": "tsx scripts/verify-analytics-logic.ts",
    "test:mapping": "tsx scripts/verify-canonical-mapping.ts",
    "test:ai": "node --import tsx --conditions react-server scripts/verify-ai-analyst.mts",
    "test:money-guard": "tsx scripts/verify-money-guard.ts",
    "test:integration-engine": "node --import tsx --conditions react-server scripts/verify-integration-engine.mts",
    "test:woocommerce": "node --import tsx --conditions react-server scripts/verify-woocommerce.mts",
    "test:google-sheets": "node --import tsx --conditions react-server scripts/verify-google-sheets.mts",
    "test:automation": "node --import tsx --conditions react-server scripts/verify-automation.mts",
    "test:marketplaces": "node --import tsx scripts/verify-marketplace-contract.mts",
    "test:amazon": "node --import tsx scripts/verify-amazon-adapter.mts",
    "test:automation-live": "node --import tsx --conditions react-server scripts/verify-automation-live.mts",
    "test:analytics-data": "node --import tsx scripts/verify-analytics-data.mts",
    "test:analytics-foundation": "node --import tsx scripts/verify-analytics-foundation.mts",
    "test:costs": "node --import tsx scripts/verify-cost-stability.mts",
    "test:source-truth": "node --import tsx scripts/verify-source-truth.mts",
    "test:mapping-data": "node --import tsx scripts/verify-mapping-profiles.mts",
    "test:migration-0010": "node --import tsx --conditions react-server scripts/verify-migration-0010.mts",
    "test:money-boundary": "node --import tsx --conditions react-server scripts/verify-money-boundary.mts",
    "test:integration-live": "node --import tsx --conditions react-server scripts/verify-integration-live.mts",
    "test:withdrawal": "node --import tsx scripts/verify-import-withdrawal.mts",
    "test:ledger": "node --import tsx scripts/verify-ledger-foundation.mts",
    "test:amazon-ledger": "node --import tsx --conditions react-server scripts/verify-amazon-ledger.mts",
    "test:amazon-acceptance": "node --import tsx --conditions react-server scripts/verify-amazon-acceptance.mts",
    "ai:check": "node --import tsx --conditions react-server scripts/check-openai.mts",
    "template": "node --import tsx --conditions react-server scripts/make-import-template.mts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.42.0",
    "next": "16.3.4",
    "papaparse": "^5.7.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "overrides": {
    "uuid": "^11.1.0"
  }
